import { Component, inject, signal, computed, OnInit, OnDestroy } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { Subject, takeUntil } from 'rxjs';
import { debounceTime, distinctUntilChanged } from 'rxjs/operators';

import { CartRuleUsageService } from '../../../services/cart-rule-usage.service';
import { CartRuleUsageDto } from '../../../models/cart-rule-usage.model';
import { SmartTableParam } from '../../../models/SmartTableParam';
import { ToastService } from '../../../services/toast.service';
import { PaginationComponent } from '../../../shared/pagination/pagination.component';

interface SearchFilters {
  ruleName: string;
  couponCode: string;
  fullName: string;
  orderId: string;
  createdOnBefore: string;
  createdOnAfter: string;
}

@Component({
  selector: 'app-cart-rule-usage-list',
  standalone: true,
  imports: [CommonModule, FormsModule, PaginationComponent],
  templateUrl: './cart-rule-usage-list.component.html',
  styleUrl: './cart-rule-usage-list.component.css',
})
export class CartRuleUsageListComponent implements OnInit, OnDestroy {
  cartRuleUsageService = inject(CartRuleUsageService);
  private toast = inject(ToastService);

  usages = signal<CartRuleUsageDto[]>([]);
  currentPage = signal(1);
  pageSize = signal(10);
  totalRecords = signal(0);
  loading = signal(false);

  searchFilters = signal<SearchFilters>({
    ruleName: '',
    couponCode: '',
    fullName: '',
    orderId: '',
    createdOnBefore: '',
    createdOnAfter: '',
  });

  hasActiveFilters = computed(() => {
    const f = this.searchFilters();
    return !!(
      f.ruleName ||
      f.couponCode ||
      f.fullName ||
      f.orderId ||
      f.createdOnBefore ||
      f.createdOnAfter
    );
  });

  private searchSubject = new Subject<void>();
  private destroy$ = new Subject<void>();

  ngOnInit(): void {
    this.searchSubject.pipe(
      debounceTime(300),
      distinctUntilChanged(),
      takeUntil(this.destroy$)
    ).subscribe(() => {
      this.currentPage.set(1);
      this.loadUsages();
    });

    this.loadUsages();
  }

  ngOnDestroy(): void {
    this.destroy$.next();
    this.destroy$.complete();
  }

  loadUsages(): void {
    this.loading.set(true);

    const search: SmartTableParam['search'] = {};
    const predicates: Record<string, any> = {};

    const filters = this.searchFilters();

    if (filters.ruleName) {
      predicates['ruleName'] = filters.ruleName;
    }
    if (filters.couponCode) {
      predicates['couponCode'] = filters.couponCode;
    }
    if (filters.fullName) {
      predicates['fullName'] = filters.fullName;
    }
    if (filters.orderId) {
      predicates['orderId'] = filters.orderId;
    }
    if (filters.createdOnBefore) {
      predicates['createdOnBefore'] = filters.createdOnBefore;
    }
    if (filters.createdOnAfter) {
      predicates['createdOnAfter'] = filters.createdOnAfter;
    }

    if (Object.keys(predicates).length > 0) {
      search.PredicateObject = predicates;
    }

    const params: SmartTableParam = {
      pagination: {
        Page: this.currentPage(),
        PageSize: this.pageSize(),
        Start: (this.currentPage() - 1) * this.pageSize(),
      },
      search: Object.keys(predicates).length > 0 ? search : undefined,
    };

    this.cartRuleUsageService.getCartRuleUsages(params).subscribe({
      next: (result) => {
        this.usages.set(result.data);
        this.totalRecords.set(result.total);
        this.loading.set(false);
      },
      error: () => {
        this.toast.error('Failed to load cart rule usages');
        this.loading.set(false);
      },
    });
  }

  updateFilter<K extends keyof SearchFilters>(field: K, value: string): void {
    this.searchFilters.update(filters => ({ ...filters, [field]: value }));
    this.searchSubject.next();
  }

  onPageChange(page: number): void {
    this.currentPage.set(page);
    this.loadUsages();
  }

  clearFilters(): void {
    this.searchFilters.set({
      ruleName: '',
      couponCode: '',
      fullName: '',
      orderId: '',
      createdOnBefore: '',
      createdOnAfter: '',
    });
    this.currentPage.set(1);
    this.loadUsages();
  }
}
